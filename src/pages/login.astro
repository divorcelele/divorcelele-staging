---
import Layout from '../layouts/Layout.astro';
import AuthWidget from '../components/auth/AuthWidget.tsx';
---
<Layout title="Sign In">
  <div class="flex-1 flex flex-col items-center justify-center p-6 min-h-[90vh]">
    <!-- client:load ensures React mounts immediately on the edge -->
    <AuthWidget returnUrl="/account" client:load />
  </div>
</Layout>