---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DivorceLele | Smart AI Divorce Assistant">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <div class="bg-[#EAE4D6] text-[#21242C] font-sans antialiased min-h-screen selection:bg-[#7A2E2E]/20 relative">

    <!-- HERO SECTION -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-32 px-6 text-center max-w-4xl mx-auto">
      <h1 class="font-serif text-[clamp(2.25rem,5vw,4.5rem)] font-medium text-[#21242C] mb-6 leading-[1.1] tracking-tight">
        Your strategic advantage in family court
      </h1>
      <p class="text-[1.1rem] md:text-xl text-[#4A4E58] mb-10 max-w-2xl mx-auto leading-relaxed">
        A privacy-focused AI assistant trained on thousands of public case hearings. Secure fair support, protect your hard-earned assets, and eliminate hourly retainer anxiety.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/assistant" class="px-7 py-3.5 bg-[#21242C] text-[#EAE4D6] text-[15px] font-medium rounded-md hover:bg-[#4A4E58] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#21242C] shadow-sm">
          Try the assistant
        </a>
        <a href="/pricing" class="px-7 py-3.5 bg-[#FBF9F4] text-[#21242C] text-[15px] font-medium rounded-md border border-[#DBD3C1] hover:bg-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#21242C]">
          Compare pricing plans
        </a>
      </div>
    </section>

    <!-- INVISIBLE SENTINEL TO TRIGGER STICKY CTA -->
    <div id="hero-sentinel" class="w-full h-px invisible" aria-hidden="true"></div>

    <!-- FEATURES SECTION -->
    <section id="features" class="py-24 md:py-32 px-6 border-t border-[#DBD3C1] bg-[#FBF9F4]">
      <div class="max-w-[1120px] mx-auto">
        <div class="max-w-[640px] mb-30 mx-auto text-center">
          <h2 class="font-serif text-[clamp(1.875rem,4vw,2.5rem)] font-medium text-[#21242C] leading-[1.15] mb-4">
            Strategic tools for complex proceedings
          </h2>
          <p class="text-[17px] text-[#4A4E58] leading-relaxed">
            Your pocket-sized second layer of defense, from initial planning to final settlement — without the legal jargon.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Vault -->
          <div class="relative bg-white border border-[#DBD3C1] rounded-md p-9 flex flex-col pt-12 mt-4 lg:mt-0">
            <span class="absolute top-0 left-9 -translate-y-full bg-[#21242C] text-[#EAE4D6] text-[12.5px] font-medium px-3.5 py-1.5 rounded-t-md tracking-wide">
              Evidence
            </span>
            <div class="w-11 h-11 rounded border border-[#DBD3C1] bg-[#EAE4D6] flex items-center justify-center mb-6">
              <svg class="w-5 h-5 text-[#7A2E2E]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v2" />
              </svg>
            </div>
            <h3 class="font-serif text-[21px] font-medium text-[#21242C] mb-5">Evidence & asset vault</h3>
            <ul class="border-t border-[#DBD3C1] flex-grow">
              <li class="py-3.5 border-b border-[#DBD3C1] text-[14.5px] text-[#4A4E58] flex gap-3 items-baseline">
                <div class="w-1.5 h-1.5 rounded-full bg-[#A8813F] shrink-0 -translate-y-[2px]"></div>
                Tag and organize toxic WhatsApp chats into structured court annexures.
              </li>
              <li class="py-3.5 border-b border-[#DBD3C1] text-[14.5px] text-[#4A4E58] flex gap-3 items-baseline">
                <div class="w-1.5 h-1.5 rounded-full bg-[#A8813F] shrink-0 -translate-y-[2px]"></div>
                Format digital logs to strictly fulfill Section 63 BSA criteria.
              </li>
              <li class="py-3.5 text-[14.5px] text-[#4A4E58] flex gap-3 items-baseline">
                <div class="w-1.5 h-1.5 rounded-full bg-[#A8813F] shrink-0 -translate-y-[2px]"></div>
                Build itemized Stridhan and asset recovery schedules.
              </li>
            </ul>
          </div>

          <!-- Disclosures -->
          <div class="relative bg-white border border-[#DBD3C1] rounded-md p-9 flex flex-col pt-12 mt-4 lg:mt-0">
            <span class="absolute top-0 left-9 -translate-y-full bg-[#21242C] text-[#EAE4D6] text-[12.5px] font-medium px-3.5 py-1.5 rounded-t-md tracking-wide">
              Filings
            </span>
            <div class="w-11 h-11 rounded border border-[#DBD3C1] bg-[#EAE4D6] flex items-center justify-center mb-6">
              <svg class="w-5 h-5 text-[#21242C]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="font-serif text-[21px] font-medium text-[#21242C] mb-5">Statutory disclosures</h3>
            <ul class="border-t border-[#DBD3C1] flex-grow">
              <li class="py-3.5 border-b border-[#DBD3C1] text-[14.5px] text-[#4A4E58] flex gap-3 items-baseline">
                <div class="w-1.5 h-1.5 rounded-full bg-[#A8813F] shrink-0 -translate-y-[2px]"></div>
                Auto-format complex financial affidavits accurately.
              </li>
              <li class="py-3.5 border-b border-[#DBD3C1] text-[14.5px] text-[#4A4E58] flex gap-3 items-baseline">
                <div class="w-1.5 h-1.5 rounded-full bg-[#A8813F] shrink-0 -translate-y-[2px]"></div>
                Comply with Supreme Court mandatory templates (Rajnesh v. Neha).
              </li>
              <li class="py-3.5 text-[14.5px] text-[#4A4E58] flex gap-3 items-baseline">
                <div class="w-1.5 h-1.5 rounded-full bg-[#A8813F] shrink-0 -translate-y-[2px]"></div>
                Instantly translate and break down opposing counsel legal notices.
              </li>
            </ul>
          </div>

          <!-- Prep -->
          <div class="relative bg-white border border-[#DBD3C1] rounded-md p-9 flex flex-col pt-12 mt-4 lg:mt-0">
            <span class="absolute top-0 left-9 -translate-y-full bg-[#21242C] text-[#EAE4D6] text-[12.5px] font-medium px-3.5 py-1.5 rounded-t-md tracking-wide">
              Strategy
            </span>
            <div class="w-11 h-11 rounded border border-[#DBD3C1] bg-[#EAE4D6] flex items-center justify-center mb-6">
              <svg class="w-5 h-5 text-[#21242C]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="8" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="12" cy="12" r="0.5" fill="currentColor" />
              </svg>
            </div>
            <h3 class="font-serif text-[21px] font-medium text-[#21242C] mb-5">Trial & prep strategy</h3>
            <ul class="border-t border-[#DBD3C1] flex-grow">
              <li class="py-3.5 border-b border-[#DBD3C1] text-[14.5px] text-[#4A4E58] flex gap-3 items-baseline">
                <div class="w-1.5 h-1.5 rounded-full bg-[#A8813F] shrink-0 -translate-y-[2px]"></div>
                Rehearse hostile questions privately with AI mock cross-examinations.
              </li>
              <li class="py-3.5 border-b border-[#DBD3C1] text-[14.5px] text-[#4A4E58] flex gap-3 items-baseline">
                <div class="w-1.5 h-1.5 rounded-full bg-[#A8813F] shrink-0 -translate-y-[2px]"></div>
                Convert years of complex history into a fact-checked marital timeline.
              </li>
              <li class="py-3.5 text-[14.5px] text-[#4A4E58] flex gap-3 items-baseline">
                <div class="w-1.5 h-1.5 rounded-full bg-[#A8813F] shrink-0 -translate-y-[2px]"></div>
                Structure strategic filings with pinpoint AI accuracy.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- VIDEO DEMO SECTION -->
    <section class="py-24 md:py-32 px-6 border-t border-[#DBD3C1] bg-[#EAE4D6]">
      <div class="max-w-[1000px] mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="font-serif text-[clamp(1.75rem,3.6vw,2.25rem)] font-medium text-[#21242C] mb-4">
            See the assistant in action
          </h2>
          <p class="text-[17px] text-[#4A4E58]">
            Watch how we turn months of chaotic WhatsApp logs and financial documents into court-ready files in under 2 minutes.
          </p>
        </div>
        
        <div class="rounded-xl md:rounded-2xl overflow-hidden border border-[#DBD3C1] bg-[#21242C] group cursor-pointer relative transition-transform hover:-translate-y-1 duration-300 shadow-xl">
          <div class="aspect-video relative flex items-center justify-center overflow-hidden">
            <!-- Simulated Video Thumbnail Background -->
            <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&q=80')] bg-cover bg-center opacity-30 mix-blend-luminosity transition-transform duration-700 group-hover:scale-105"></div>
            
            <!-- Dark Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#21242C]/80 via-[#21242C]/20 to-transparent"></div>
            
            <!-- Play Button -->
            <div class="w-16 h-16 md:w-20 md:h-20 bg-white/10 backdrop-blur-md border border-white/20 text-white rounded-full flex items-center justify-center transform group-hover:scale-110 group-hover:bg-white group-hover:text-[#7A2E2E] transition-all duration-300 relative z-10 shadow-2xl">
              <svg class="w-6 h-6 md:w-8 md:h-8 ml-1 md:ml-1.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- USER TESTIMONIALS SECTION -->
    <section id="reviews" class="py-24 md:py-32 px-6 border-t border-[#DBD3C1] bg-[#FBF9F4]">
      <div class="max-w-[1120px] mx-auto">
        <div class="max-w-[640px] mb-16 mx-auto text-center">
          <h2 class="font-serif text-[clamp(1.75rem,3.6vw,2.25rem)] font-medium text-[#21242C] mb-4">
            Trusted by people in your shoes
          </h2>
          <p class="text-[17px] text-[#4A4E58] leading-relaxed">
            Real outcomes from users navigating family court. Identities are strictly protected for absolute privacy.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-8 rounded-md border border-[#DBD3C1] flex flex-col justify-between shadow-sm">
            <p class="text-[#4A4E58] text-[15px] leading-relaxed mb-8 italic">
              "I was paying my lawyer a fortune just to read through toxic WhatsApp chats. The assistant categorized everything into neat annexures in seconds. Paid for itself instantly."
            </p>
            <div class="border-t border-[#DBD3C1] pt-4 mt-auto">
              <p class="text-[14px] font-semibold text-[#21242C]">R., Delhi</p>
              <p class="text-[12.5px] text-[#A8813F] font-medium mt-0.5">Identity Protected</p>
            </div>
          </div>
          
          <div class="bg-white p-8 rounded-md border border-[#DBD3C1] flex flex-col justify-between shadow-sm">
            <p class="text-[#4A4E58] text-[15px] leading-relaxed mb-8 italic">
              "The mock cross-examination tool helped me stay calm. Practicing the hostile questions privately meant I didn't lose my temper in actual mediation."
            </p>
            <div class="border-t border-[#DBD3C1] pt-4 mt-auto">
              <p class="text-[14px] font-semibold text-[#21242C]">S., Mumbai</p>
              <p class="text-[12.5px] text-[#A8813F] font-medium mt-0.5">Identity Protected</p>
            </div>
          </div>

          <div class="bg-white p-8 rounded-md border border-[#DBD3C1] flex flex-col justify-between shadow-sm">
            <p class="text-[#4A4E58] text-[15px] leading-relaxed mb-8 italic">
              "Formatting my financial affidavit accurately felt impossible until I used this. It perfectly matched the Supreme Court templates my lawyer required."
            </p>
            <div class="border-t border-[#DBD3C1] pt-4 mt-auto">
              <p class="text-[14px] font-semibold text-[#21242C]">A., Bengaluru</p>
              <p class="text-[12.5px] text-[#A8813F] font-medium mt-0.5">Identity Protected</p>
            </div>
          </div>

          <div class="bg-white p-8 rounded-md border border-[#DBD3C1] flex flex-col justify-between shadow-sm">
            <p class="text-[#4A4E58] text-[15px] leading-relaxed mb-8 italic">
              "I had documents scattered across emails, PDFs, and messages. Having everything organized in one place made preparing for my hearing much less overwhelming."
            </p>
            <div class="border-t border-[#DBD3C1] pt-4 mt-auto">
              <p class="text-[14px] font-semibold text-[#21242C]">P., Pune</p>
              <p class="text-[12.5px] text-[#A8813F] font-medium mt-0.5">Identity Protected</p>
            </div>
          </div>

          <div class="bg-white p-8 rounded-md border border-[#DBD3C1] flex flex-col justify-between shadow-sm">
            <p class="text-[#4A4E58] text-[15px] leading-relaxed mb-8 italic">
              "The timeline feature saved me hours. I could finally see the important events in order instead of digging through months of messages and documents."
            </p>
            <div class="border-t border-[#DBD3C1] pt-4 mt-auto">
              <p class="text-[14px] font-semibold text-[#21242C]">N., Hyderabad</p>
              <p class="text-[12.5px] text-[#A8813F] font-medium mt-0.5">Identity Protected</p>
            </div>
          </div>

          <div class="bg-white p-8 rounded-md border border-[#DBD3C1] flex flex-col justify-between shadow-sm">
            <p class="text-[#4A4E58] text-[15px] leading-relaxed mb-8 italic">
              "I didn't know where to start with all the paperwork. The assistant broke everything down into manageable steps and helped me prepare questions for my lawyer."
            </p>
            <div class="border-t border-[#DBD3C1] pt-4 mt-auto">
              <p class="text-[14px] font-semibold text-[#21242C]">M., Chennai</p>
              <p class="text-[12.5px] text-[#A8813F] font-medium mt-0.5">Identity Protected</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LAWYER TESTIMONIALS SECTION -->
    <section id="lawyer-reviews" class="py-24 md:py-32 px-6 border-t border-[#DBD3C1] bg-[#EAE4D6]">
      <div class="max-w-[1200px] mx-auto">
        <div class="max-w-[640px] mb-16 mx-auto text-center">
          <h2 class="font-serif text-[clamp(1.75rem,3.6vw,2.25rem)] font-medium text-[#21242C] mb-4">
            Backed by top Indian lawyers
          </h2>
          <p class="text-[17px] text-[#4A4E58] leading-relaxed">
            Advocates across High Courts and Family Courts recommend DivorceLele to their clients to organize evidence and streamline case prep.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- Lawyer 1 -->
          <div class="bg-white border border-[#DBD3C1] rounded-md overflow-hidden shadow-sm flex flex-col group">
            <div class="aspect-[16/9] relative bg-[#21242C] cursor-pointer overflow-hidden">
              <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1589829085413-56de8ae18c73?auto=format&fit=crop&q=80')] bg-cover bg-center opacity-40 mix-blend-luminosity group-hover:opacity-60 transition-opacity"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 bg-white/20 backdrop-blur-sm border border-white/30 text-white rounded-full flex items-center justify-center transform group-hover:scale-110 group-hover:bg-white group-hover:text-[#21242C] transition-all duration-300">
                  <svg class="w-5 h-5 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
            </div>
            <div class="p-6 flex flex-col flex-grow justify-between">
              <p class="text-[#4A4E58] text-[14.5px] leading-relaxed mb-6 italic">
                "I now ask all my new clients to run their raw WhatsApp histories and financials through DivorceLele before our first consultation. It transforms weeks of tedious paralegal work into a 5-minute task."
              </p>
              <div class="border-t border-[#DBD3C1] pt-4 mt-auto">
                <p class="text-[14px] font-semibold text-[#21242C]">Adv. Priya Sharma</p>
                <p class="text-[12.5px] text-[#4A4E58] mt-0.5">Practicing Advocate, Delhi High Court</p>
              </div>
            </div>
          </div>

          <!-- Lawyer 2 -->
          <div class="bg-white border border-[#DBD3C1] rounded-md overflow-hidden shadow-sm flex flex-col group">
            <div class="aspect-[16/9] relative bg-[#21242C] cursor-pointer overflow-hidden">
              <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1556157382-97eda2d62296?auto=format&fit=crop&q=80')] bg-cover bg-center opacity-40 mix-blend-luminosity group-hover:opacity-60 transition-opacity"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 bg-white/20 backdrop-blur-sm border border-white/30 text-white rounded-full flex items-center justify-center transform group-hover:scale-110 group-hover:bg-white group-hover:text-[#21242C] transition-all duration-300">
                  <svg class="w-5 h-5 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
            </div>
            <div class="p-6 flex flex-col flex-grow justify-between">
              <p class="text-[#4A4E58] text-[14.5px] leading-relaxed mb-6 italic">
                "The Rajnesh v. Neha affidavit generator is flawless. It prevents the constant back-and-forth I usually have with clients trying to get their financial disclosures formatted correctly for the court."
              </p>
              <div class="border-t border-[#DBD3C1] pt-4 mt-auto">
                <p class="text-[14px] font-semibold text-[#21242C]">Adv. Vikram Desai</p>
                <p class="text-[12.5px] text-[#4A4E58] mt-0.5">Family Court, Mumbai</p>
              </div>
            </div>
          </div>

          <!-- Lawyer 3 -->
          <div class="bg-white border border-[#DBD3C1] rounded-md overflow-hidden shadow-sm flex flex-col group">
            <div class="aspect-[16/9] relative bg-[#21242C] cursor-pointer overflow-hidden">
              <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80')] bg-cover bg-center opacity-40 mix-blend-luminosity group-hover:opacity-60 transition-opacity"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 bg-white/20 backdrop-blur-sm border border-white/30 text-white rounded-full flex items-center justify-center transform group-hover:scale-110 group-hover:bg-white group-hover:text-[#21242C] transition-all duration-300">
                  <svg class="w-5 h-5 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
              </div>
            </div>
            <div class="p-6 flex flex-col flex-grow justify-between">
              <p class="text-[#4A4E58] text-[14.5px] leading-relaxed mb-6 italic">
                "By the time a client using this platform walks into my office, their timeline is strict, evidence is Section 63 compliant, and they are ready to talk strategy instead of venting emotions."
              </p>
              <div class="border-t border-[#DBD3C1] pt-4 mt-auto">
                <p class="text-[14px] font-semibold text-[#21242C]">Adv. Ananya Iyer</p>
                <p class="text-[12.5px] text-[#4A4E58] mt-0.5">Karnataka High Court</p>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section id="faq" class="py-24 md:py-32 px-6 border-t border-[#DBD3C1] bg-[#FBF9F4]">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="font-serif text-[clamp(1.75rem,3.6vw,2.25rem)] font-medium text-[#21242C] mb-3">
            Common questions
          </h2>
          <p class="text-[17px] text-[#4A4E58]">
            Clear answers about privacy, legality, and how the assistant works.
          </p>
        </div>
        
        <div class="space-y-4">
          <details class="group bg-white p-6 md:p-8 rounded-md border border-[#DBD3C1] cursor-pointer [&_summary::-webkit-details-marker]:hidden shadow-sm">
            <summary class="flex justify-between items-center font-medium text-[#21242C] text-[16px]">
              <span>Is my case data and evidence kept private?</span>
              <span class="transition duration-300 group-open:-rotate-180 text-[#7A2E2E]">
                <svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M6 9l6 6 6-6"></path></svg>
              </span>
            </summary>
            <p class="text-[#4A4E58] mt-4 leading-relaxed text-[15px]">
              Absolutely. We use end-to-end encryption and do not train our AI models on your personal case data. Your evidence vault remains strictly confidential, and you can securely wipe your data from our servers at any time.
            </p>
          </details>

          <details class="group bg-white p-6 md:p-8 rounded-md border border-[#DBD3C1] cursor-pointer [&_summary::-webkit-details-marker]:hidden shadow-sm">
            <summary class="flex justify-between items-center font-medium text-[#21242C] text-[16px]">
              <span>Will this replace my lawyer?</span>
              <span class="transition duration-300 group-open:-rotate-180 text-[#7A2E2E]">
                <svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M6 9l6 6 6-6"></path></svg>
              </span>
            </summary>
            <p class="text-[#4A4E58] mt-4 leading-relaxed text-[15px]">
              No. DivorceLele is designed to make you the most prepared client your lawyer has ever had. By organizing your own timelines, evidence, and financial disclosures, you drastically reduce the billable hours your lawyer spends on administrative work, saving you money for actual legal strategy.
            </p>
          </details>

          <details class="group bg-white p-6 md:p-8 rounded-md border border-[#DBD3C1] cursor-pointer [&_summary::-webkit-details-marker]:hidden shadow-sm">
            <summary class="flex justify-between items-center font-medium text-[#21242C] text-[16px]">
              <span>Is the formatted evidence accepted in court?</span>
              <span class="transition duration-300 group-open:-rotate-180 text-[#7A2E2E]">
