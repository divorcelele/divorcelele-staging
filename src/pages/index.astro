---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home | DivorceLele">
  <section class="py-12">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Welcome to DivorceLele</h1>
    <p class="text-lg text-slate-600 mb-8">
      Your new homepage is now successfully structured with Astro components and Tailwind CSS.
    </p>
    
    <div class="grid md:grid-cols-2 gap-6">
      <div class="p-6 bg-slate-50 border border-slate-200 rounded-lg">
        <h2 class="text-xl font-bold mb-2">Fast Performance</h2>
        <p class="text-slate-600">Zero unnecessary JavaScript shipped to the client by default.</p>
      </div>
      <div class="p-6 bg-slate-50 border border-slate-200 rounded-lg">
        <h2 class="text-xl font-bold mb-2">Tailwind Ready</h2>
        <p class="text-slate-600">Utility classes are fully configured and ready to use.</p>
      </div>
    </div>
  </section>
</Layout>