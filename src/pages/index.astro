<script>
    document.addEventListener('DOMContentLoaded', () => {
      const stickyCta = document.getElementById('sticky-cta');
      const sentinel = document.getElementById('hero-sentinel');
      const pricingSection = document.getElementById('pricing');

      if (!stickyCta || !sentinel || !pricingSection) return;

      // Prevent the load "blink" by adding animations only after initial render
      setTimeout(() => {
        stickyCta.classList.add('transition-transform', 'duration-300', 'ease-in-out');
      }, 100);

      let isPastHero = false;
      let isReachedPricing = false;

      const updateCTAVisibility = () => {
        if (isPastHero && !isReachedPricing) {
          stickyCta.setAttribute('data-visible', 'true');
        } else {
          stickyCta.setAttribute('data-visible', 'false');
        }
      };

      const sentinelObserver = new IntersectionObserver((entries) => {
        const entry = entries[0];
        isPastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        updateCTAVisibility();
      });

      const pricingObserver = new IntersectionObserver((entries) => {
        const entry = entries[0];
        
        if (entry.isIntersecting) {
          isReachedPricing = true;
        } else {
          isReachedPricing = entry.boundingClientRect.top < 0;
        }
        
        updateCTAVisibility();
      });

      sentinelObserver.observe(sentinel);
      pricingObserver.observe(pricingSection);
    });
  </script>


