---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Data Deletion Policy | Smart AI Divorce Assistant">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <div class="bg-[#EAE4D6] text-[#21242C] font-sans antialiased min-h-screen selection:bg-[#7A2E2E]/20 py-20 md:py-32">
    <div class="max-w-[800px] mx-auto px-6">

      <!-- Hero -->
      <header class="mb-12 border-b border-[#DBD3C1] pb-10">
        <h1 class="font-serif text-[clamp(2.25rem,4vw,3.5rem)] font-medium text-[#21242C] mb-4 leading-[1.15] tracking-tight">
          Your case. Your data. Your control.
        </h1>
        <p class="text-[17px] text-[#4A4E58] leading-relaxed max-w-2xl">
          Due to the highly sensitive nature of family court proceedings, DivorceLele operates on a strict zero-retention policy upon request. You have the right to permanently purge your files at any time.
        </p>
      </header>

      <!-- The Policy -->
      <div class="prose prose-slate max-w-none">
        
        <h2 class="font-serif text-2xl text-[#21242C] mb-4">What happens when you request deletion?</h2>
        <p class="text-[15.5px] text-[#4A4E58] leading-relaxed mb-6">
          When you initiate a data purge, the following actions are taken across our infrastructure:
        </p>
        
        <ul class="space-y-4 mb-10">
          <li class="flex items-start gap-3 text-[15px] text-[#4A4E58]">
            <svg class="w-5 h-5 text-[#7A2E2E] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            <span><strong>Evidence Vault:</strong> All uploaded WhatsApp exports, PDFs, images, and chat logs are immediately and irretrievably deleted from our secure cloud storage.</span>
          </li>
          <li class="flex items-start gap-3 text-[15px] text-[#4A4E58]">
            <svg class="w-5 h-5 text-[#7A2E2E] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            <span><strong>Generated Filings:</strong> Any AI-generated timelines, affidavits, Stridhan schedules, and cross-examination drafts are wiped from the database.</span>
          </li>
          <li class="flex items-start gap-3 text-[15px] text-[#4A4E58]">
            <svg class="w-5 h-5 text-[#7A2E2E] shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            <span><strong>Account Details:</strong> Your email, profile data, and subscription history are anonymized and removed.</span>
          </li>
        </ul>

        <div class="bg-[#FBF9F4] border-l-4 border-[#A8813F] p-6 mb-12 rounded-r-md">
          <p class="text-[14px] text-[#4A4E58] mb-0 italic">
            <strong>Important Note:</strong> Once a deletion request is executed, it cannot be undone. We do not keep shadow backups of user evidence. Please ensure you have downloaded all necessary annexures and affidavits to your local device before requesting a purge.
          </p>
        </div>

        <h2 class="font-serif text-2xl text-[#21242C] mb-6">How to initiate a data purge</h2>
        
        <!-- Action Box -->
        <div class="bg-white border border-[#DBD3C1] rounded-md p-8 shadow-sm text-center">
          <div class="w-12 h-12 bg-[#EAE4D6] rounded-full flex items-center justify-center mx-auto mb-4 border border-[#DBD3C1]">
            <svg class="w-6 h-6 text-[#21242C]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v2" /></svg>
          </div>
          <h3 class="text-[18px] font-medium text-[#21242C] mb-2">Automated Deletion</h3>
          <p class="text-[14.5px] text-[#4A4E58] mb-8 max-w-sm mx-auto">
            The fastest way to permanently delete your data is directly through your secure account settings.
          </p>
          <a href="/account" class="inline-flex items-center gap-2 px-8 py-3.5 bg-[#21242C] text-[#EAE4D6] text-[14.5px] font-medium rounded-md hover:bg-[#4A4E58] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#21242C] shadow-sm">
            Go to Account Settings
          </a>
        </div>

        <p class="text-[14px] text-[#4A4E58] mt-10 text-center">
          Having trouble logging in? You can also request a manual deletion by emailing <a href="mailto:privacy@divorcelele.in" class="text-[#7A2E2E] hover:underline">privacy@divorcelele.in</a> from your registered email address. Manual requests are processed within 7 business days.
        </p>

      </div>

    </div>
  </div>
</Layout>

<style>
  .font-serif { font-family: 'Fraunces', serif; }
  .font-sans { font-family: 'Public Sans', sans-serif; }
</style>