---
import Layout from '../layouts/Layout.astro';
import AuthWidget from '../components/auth/AuthWidget';
---

<Layout title="Account | Smart AI Divorce Assistant">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <main class="min-h-[calc(100vh-80px)] flex flex-col items-center justify-start pt-40 pb-12 bg-[#F2EEE5] px-6 font-sans selection:bg-[#7A2E2E]/20">

    <!-- Auth Widget Wrapper -->
    <div class="w-full max-w-sm relative z-10">
      <AuthWidget returnUrl="/account" client:load />
    </div>

    <!-- Bottom Links (Hidden when logged in) -->
    <div id="auth-bottom-links" class="mt-8 flex items-center gap-6 transition-opacity duration-300">
      <a href="/" class="text-[14px] font-medium text-[#4A4E58] hover:text-[#21242C] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7A2E2E] rounded-sm">
        &larr; Back to home
      </a>
      <a href="/contact" class="text-[14px] font-medium text-[#4A4E58] hover:text-[#21242C] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7A2E2E] rounded-sm">
        Need help?
      </a>
    </div>

  </main>
</Layout>

<style>
  .font-serif { font-family: 'Fraunces', serif; }
  .font-sans { font-family: 'Public Sans', sans-serif; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bottomLinks = document.getElementById('auth-bottom-links');
    
    // Check if there is an existing session hint in localStorage
    // For Better Auth, it usually manages HttpOnly cookies, so you may just rely on the React event.
    // If you want to guess based on localstorage, check your specific Better Auth client config.
    const hasLikelySession = document.cookie.includes('better-auth');
    
    if (hasLikelySession && bottomLinks) {
      bottomLinks.style.display = 'none';
    }

    // Listen for custom event from React AuthWidget
    window.addEventListener('auth-state-changed', (e) => {
      if (bottomLinks) {
        // Only hide if the payload indicates a successful login
        if (e.detail && e.detail.isLoggedIn) {
          bottomLinks.style.opacity = '0';
          setTimeout(() => {
            bottomLinks.style.display = 'none';
          }, 300);
        } else {
          // Show links again on logout
          bottomLinks.style.display = 'flex';
          setTimeout(() => {
            bottomLinks.style.opacity = '1';
          }, 10);
        }
      }
    });
  });
</script>