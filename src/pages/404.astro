---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found">
  <div class="flex-1 flex flex-col items-center justify-center p-6 min-h-[70vh] text-center">
    <h1 class="text-4xl font-bold text-slate-900 mb-4">404</h1>
    <p class="text-lg text-slate-600 mb-8">The page you are looking for does not exist.</p>
    <a href="/" class="px-6 py-3 bg-slate-900 text-white rounded-lg font-semibold hover:bg-slate-800 transition">
      Go back home
    </a>
  </div>
</Layout>