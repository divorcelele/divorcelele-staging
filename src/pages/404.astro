---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Page Not Found | Smart AI Divorce Assistant">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <main class="min-h-[calc(100vh-80px)] flex flex-col items-center justify-center bg-[#EAE4D6] px-6 py-20 font-sans selection:bg-[#7A2E2E]/20 text-center">
    
    <h1 class="font-serif text-[clamp(5rem,15vw,8rem)] font-medium text-[#21242C] leading-none tracking-tighter mb-2">
      404
    </h1>
    <h2 class="text-[14px] text-[#7A2E2E] font-semibold tracking-widest uppercase mb-4">
      Page not found
    </h2>
    <p class="text-[16px] text-[#4A4E58] leading-relaxed max-w-sm mb-10">
      The link you followed may be broken, or the page has been struck from the record. 
    </p>

    <a href="/" class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#21242C] text-[#EAE4D6] text-[15px] font-medium rounded-md hover:bg-[#4A4E58] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#21242C] shadow-sm">
      &larr; Return to homepage
    </a>

  </main>
</Layout>

<style>
  .font-serif { font-family: 'Fraunces', serif; }
  .font-sans { font-family: 'Public Sans', sans-serif; }
</style>