---
import Layout from '../../layouts/Layout.astro';

const phases = [
  {
    title: "Preparation & Strategy",
    description: "In India, the most crucial early step is understanding which personal law applies and securing proof of assets before things turn hostile.",
    chapters: [
      { slug: "which-law-applies", title: "Which Law Applies to You?", desc: "Navigating the Hindu Marriage Act (HMA), Special Marriage Act (SMA), Indian Divorce Act (Christian), and Muslim Personal Law." },
      { slug: "securing-stridhan", title: "Securing Your Stridhan", desc: "What counts as Stridhan (wedding jewelry, gifts, cash), why the husband's family has no right to it, and how to legally retrieve it." },
      { slug: "gathering-financial-proof", title: "Gathering Financial Proof", desc: "A checklist for India: securing copies of ITRs, bank statements, property registries, and proof of spouse's income." },
      { slug: "domestic-violence-fir-498a", title: "Domestic Violence & FIR 498A", desc: "Understanding legal protections against cruelty, dowry harassment, and the right to reside in the matrimonial home." }
    ]
  },
  {
    title: "The Legal Mechanics",
    description: "Unlike the US, where 'no-fault' is standard, India strictly divides divorce into Mutual Consent (peaceful) and Contested (fighting on fault grounds).",
    chapters: [
      { slug: "mutual-consent-divorce", title: "Mutual Consent Divorce", desc: "The step-by-step process, the mandatory 1-year separation requirement, and the 6-month 'cooling-off' period (and how to waive it)." },
      { slug: "contested-divorce-grounds", title: "Contested Divorce Grounds", desc: "Explaining the legally required grounds to fight a divorce (Cruelty, Adultery, Desertion, Mental Disorder)." },
      { slug: "irretrievable-breakdown", title: "Irretrievable Breakdown", desc: "Explaining why you cannot simply file for a 'no-fault' contested divorce in lower courts, and the Supreme Court's special powers." },
      { slug: "court-timeline", title: "The Court Timeline", desc: "Realistic expectations: Mutual consent (3–6 months) vs. Contested (2–5+ years)." }
    ]
  },
  {
    title: "Financial Uncoupling & Maintenance",
    description: "India does not split assets 50/50. The focus is on title ownership and securing maintenance (alimony) to prevent destitution.",
    chapters: [
      { slug: "property-real-estate", title: "Property & Real Estate", desc: "Who gets the flat? Explaining how title deeds and EMI contributions determine ownership, not marriage." },
      { slug: "interim-maintenance", title: "Interim Maintenance", desc: "How to file for monthly financial support for the wife and children during the long court proceedings." },
      { slug: "permanent-alimony", title: "Permanent Alimony", desc: "How Indian courts calculate final alimony based on the husband's status, wife's income, and lifestyle." },
      { slug: "joint-accounts-investments", title: "Joint Accounts & Investments", desc: "How to legally separate joint FDs, mutual funds, EPF/PPF accounts, and bank lockers." }
    ]
  },
  {
    title: "Children & Custody",
    description: "Indian courts prioritize the 'welfare of the child' over parental rights, and physical custody of young children usually defaults to the mother.",
    chapters: [
      { slug: "types-of-custody", title: "Types of Custody in India", desc: "Physical vs. Legal custody, and why courts are increasingly looking at 'Shared Parenting' plans." },
      { slug: "mothers-natural-rights", title: "The Mother's Natural Rights", desc: "The legal presumption under the Hindu Minority & Guardianship Act that custody of children under 5 remains with the mother." },
      { slug: "child-maintenance", title: "Child Maintenance", desc: "How courts decide who pays for school fees, medical expenses, and higher education." },
      { slug: "visitation-rights", title: "Visitation Rights", desc: "Securing structured weekend, holiday, and festival meeting rights for the non-custodial parent." }
    ]
  },
  {
    title: "Post-Divorce Administration",
    description: "After the decree is granted, Indian citizens face specific bureaucratic hurdles to update their legal identity.",
    chapters: [
      { slug: "updating-ids-pan", title: "Updating Government IDs & PAN", desc: "The exact process and documents required to revert to a maiden name on government-issued IDs." },
      { slug: "bank-nominee-updates", title: "Bank & Nominee Updates", desc: "Removing the ex-spouse as a nominee from LIC policies, bank accounts, and provident funds." },
      { slug: "appeal-window", title: "The Appeal Window", desc: "Understanding the 90-day waiting period after a contested decree before you can legally remarry." }
    ]
  }
];
---

<Layout title="Divorce Guides - India | Smart AI Divorce Assistant">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <div class="bg-[#F2EEE5] text-[#21242C] font-sans antialiased min-h-screen selection:bg-[#7A2E2E]/20 py-16 sm:py-24 md:py-32">
    <div class="max-w-[960px] mx-auto px-6">

      <header class="mb-16 sm:mb-24">
        <div class="text-[13px] text-[#7A2E2E] font-semibold mb-4 tracking-wide uppercase">Free Legal Library</div>
        <h1 class="font-serif text-[clamp(2.25rem,4vw,3.5rem)] font-medium text-[#21242C] mb-6 max-w-3xl leading-[1.15] tracking-tight">
          Plan, protect, proceed: your roadmap to divorce in India
        </h1>
        <p class="text-[17px] text-[#4A4E58] leading-relaxed max-w-2xl">
          Divorce in India is governed by complex personal laws and distinct asset rules like Stridhan. This guide walks through the legal mechanics in order — strategy, process, money, children, and what comes after — so you can plan with a clear head.
        </p>
      </header>

      <!-- CTA Break -->
      <a
        href="/assistant"
        class="group relative mb-20 sm:mb-28 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 rounded-md bg-[#21242C] px-8 py-10 sm:px-12 sm:py-12 overflow-hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#21242C] shadow-sm"
      >
        <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;" aria-hidden="true"></div>
        <div class="relative">
          <p class="text-[13px] text-[#DBD3C1] font-semibold tracking-wide uppercase mb-2">Not sure where you stand?</p>
          <h2 class="font-serif text-2xl sm:text-3xl text-[#F2EEE5] leading-snug max-w-md">
            Ask the AI divorce assistant your specific question
          </h2>
          <p class="text-[#DBD3C1] text-[15px] mt-3 max-w-md leading-relaxed">
            Free, confidential, and built on this same guide — get a straight answer in minutes, not a court date.
          </p>
        </div>
        <span class="relative shrink-0 inline-flex items-center gap-2 px-6 py-3 bg-[#7A2E2E] text-[#F2EEE5] text-[14.5px] font-medium rounded-md group-hover:bg-[#5C2222] transition-colors shadow-sm">
          Talk to the assistant
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 transition-transform group-hover:translate-x-0.5">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </span>
      </a>

      <!-- Guide Index -->
      <div>
        {phases.map((phase, index) => (
          <section
            id={`phase-${index + 1}`}
            class="relative pt-16 sm:pt-20 first:pt-0 border-t border-[#DBD3C1] first:border-t-0 mb-16 sm:mb-20"
          >
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-6 mb-4">
              <span class="font-serif text-5xl md:text-6xl text-[#DBD3C1]/80 leading-none tabular-nums select-none tracking-tighter" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2 class="font-serif text-2xl sm:text-[28px] text-[#21242C] mt-2 sm:mt-0 font-medium">
                {phase.title}
              </h2>
            </div>
            <p class="text-[15.5px] text-[#4A4E58] leading-relaxed max-w-2xl mb-10 sm:ml-[calc(4rem+1.5rem)] lg:ml-[calc(4.5rem+1.5rem)]">
              {phase.description}
            </p>

            <div class="sm:ml-[calc(4rem+1.5rem)] lg:ml-[calc(4.5rem+1.5rem)] divide-y divide-[#DBD3C1]/50">
              {phase.chapters.map((chapter) => (
                <a
                  href={`/guides/${chapter.slug}`}
                  class="group flex items-start justify-between gap-6 py-6 pl-5 pr-2 border-l-[3px] border-[#DBD3C1] hover:border-[#7A2E2E] focus-visible:border-[#7A2E2E] transition-colors duration-200 focus-visible:outline-none"
                >
                  <div class="flex flex-col gap-1.5">
                    <h3 class="text-[16px] font-semibold text-[#21242C] group-hover:text-[#7A2E2E] transition-colors">
                      {chapter.title}
                    </h3>
                    <p class="text-[14px] text-[#4A4E58] leading-relaxed max-w-lg mt-1">
                      {chapter.desc}
                    </p>
                  </div>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="w-5 h-5 mt-0.5 shrink-0 text-[#DBD3C1] group-hover:text-[#7A2E2E] group-hover:translate-x-1 transition-all duration-200"
                    aria-hidden="true"
                  >
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                  </svg>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Bottom CTA -->
      <div class="mt-20 sm:mt-28 border-t border-[#DBD3C1] pt-20">
        <div class="relative rounded-md bg-[#21242C] px-8 py-12 sm:px-14 sm:py-16 overflow-hidden shadow-sm">
          <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;" aria-hidden="true"></div>
          <div class="relative max-w-2xl">
            <p class="text-[13px] text-[#DBD3C1] font-semibold tracking-wide uppercase mb-3">Once you know where you stand</p>
            <h2 class="font-serif text-[clamp(1.75rem,3.6vw,2.25rem)] text-[#F2EEE5] leading-snug mb-5">
              Turn this guide into your actual case file
            </h2>
            <p class="text-[15.5px] text-[#DBD3C1] leading-relaxed mb-10 max-w-xl">
              The assistant organizes your WhatsApp evidence into court-ready annexures, formats mandatory financial affidavits, and lets you rehearse cross-examination privately — before you ever pay a retainer.
            </p>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
              <a
                href="/assistant"
                class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#7A2E2E] text-[#F2EEE5] text-[15px] font-medium rounded-md hover:bg-[#5C2222] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7A2E2E] shadow-sm"
              >
                Try the assistant
              </a>
              <a href="/pricing" class="text-[15px] font-medium text-[#DBD3C1] hover:text-[#F2EEE5] underline decoration-[#4A4E58] hover:decoration-[#DBD3C1] underline-offset-4 transition-colors">
                View pricing
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .font-serif { font-family: 'Fraunces', serif; }
  .font-sans { font-family: 'Public Sans', sans-serif; }
</style>