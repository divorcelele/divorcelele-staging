---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Assistant - Coming Soon">
  <main class="relative min-h-screen flex items-center justify-center bg-[#FBF9F5] px-5 py-20 overflow-hidden">

    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(circle at 1.5px 1.5px, #0f172a 1.5px, transparent 0); background-size: 24px 24px;" aria-hidden="true"></div>

    <div class="relative max-w-lg w-full text-center">
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-900 animate-pulse"></span>
        <p class="text-slate-500 text-sm font-medium">The assistant is being built</p>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl text-slate-900 leading-tight mb-5">
        Your strategic advantage in family court is almost ready
      </h1>

      <p class="text-slate-600 leading-relaxed mb-14 max-w-md mx-auto">
        A privacy-focused AI assistant for organizing evidence, formatting statutory disclosures, and preparing you for filings — without the hourly retainer anxiety. We're finishing it now.
      </p>

      <div class="pt-10 border-t border-slate-200">
        <p class="text-sm text-slate-500 mb-4">In the meantime</p>
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
          <a href="/guides" class="text-sm font-medium text-slate-900 underline decoration-slate-300 hover:decoration-slate-900 underline-offset-4 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 rounded-sm">
            Browse the free guide library
          </a>
          <a href="/pricing" class="text-sm font-medium text-slate-900 underline decoration-slate-300 hover:decoration-slate-900 underline-offset-4 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 rounded-sm">
            View pricing
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap');

  .font-serif {
    font-family: 'Source Serif 4', ui-serif, Georgia, serif;
  }
</style>