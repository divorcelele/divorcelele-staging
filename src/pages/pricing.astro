---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing - AI Legal Companion">
  <div class="bg-stone-50 min-h-screen py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold tracking-wide uppercase mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 shadow-[0_0_8px_rgba(99,102,241,0.8)]"></span>
          Built for Indian Family Court Systems
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-6">
          Strategic clarity for your <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 via-purple-500 to-fuchsia-500">divorce proceedings.</span>
        </h1>
        <p class="text-lg text-slate-600 leading-relaxed">
          Eliminate hourly retainer anxiety. Automate statutory disclosures, structure electronic WhatsApp evidence, and prepare strategic filings with AI accuracy.
        </p>
      </div>

      <!-- Segmented Control Toggle -->
      <div class="flex justify-center mb-16">
        <div class="relative bg-white border border-slate-200 p-1.5 rounded-full inline-flex shadow-sm w-80">
          <!-- Sliding Background -->
          <div id="activeSlider" class="absolute top-1.5 left-1.5 bottom-1.5 w-[calc(50%-6px)] bg-slate-900 rounded-full transition-transform duration-300 ease-out z-0"></div>
          
          <button id="tabMonthly" class="relative z-10 w-1/2 py-2.5 text-sm font-semibold text-white transition-colors duration-200 focus:outline-none">
            Monthly Billing
          </button>
          <button id="tabYearly" class="relative z-10 w-1/2 py-2.5 text-sm font-semibold text-slate-500 transition-colors duration-200 flex items-center justify-center gap-1 focus:outline-none">
            Yearly <span class="bg-emerald-100 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-full text-[0.65rem] font-bold uppercase tracking-wider ml-1">2 Mo Free</span>
          </button>
        </div>
      </div>

      <!-- Pricing Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16 items-center">
        
        <!-- Clarity Plan -->
        <div class="bg-white border border-slate-200 rounded-3xl p-8 flex flex-col shadow-sm hover:shadow-md hover:-translate-y-1 hover:border-slate-300 transition-all duration-300">
          <div class="mb-6">
            <h3 class="text-2xl font-bold text-slate-900 mb-2">Clarity</h3>
            <p class="text-sm text-slate-600 min-h-[3rem]">Designed for initial assessment, amicable mutual consent, and petition structuring.</p>
          </div>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-2xl font-semibold text-slate-900">₹</span>
            <span class="price-val text-5xl font-extrabold text-slate-900 tracking-tight" data-monthly="2,499" data-yearly="23,999">2,499</span>
            <span class="billing-period text-slate-500 font-medium">/mo</span>
          </div>
          <hr class="border-slate-100 mb-8" />
          <ul class="flex-grow space-y-4 mb-8">
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>200 AI Strategic Actions / month</strong></span>
            </li>
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Plain-Language Notice Translator:</strong> Instant Hindi & English breakdowns of opposing counsel summons and legal notices.</span>
            </li>
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Stridhan & Dowry Inventory Vault:</strong> Structure itemized jewelry, gifts, and recovery schedules ready for court submission.</span>
            </li>
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Marital Timeline Builder:</strong> Convert years of complex domestic history into a clear, fact-checked chronology for your advocate.</span>
            </li>
          </ul>
          <a href="#checkout" class="block w-full py-3.5 px-4 rounded-xl text-center font-bold transition-all border-2 border-slate-200 bg-transparent text-slate-900 hover:border-slate-900 hover:bg-slate-50">Choose Clarity</a>
        </div>

        <!-- Litigation Pro (Featured) -->
        <div class="relative bg-slate-900 border border-indigo-500/50 rounded-3xl p-8 flex flex-col shadow-2xl lg:scale-105 z-10 hover:-translate-y-1 transition-transform duration-300">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-indigo-500 to-purple-500 text-white px-4 py-1.5 rounded-full text-[0.7rem] font-bold uppercase tracking-wider shadow-lg">
            Most Recommended
          </div>
          <div class="mb-6">
            <h3 class="text-2xl font-bold text-white mb-2">Litigation Pro</h3>
            <p class="text-sm text-slate-300 min-h-[3rem]">Comprehensive toolkit for contested petitions, custody battles, and maintenance hearings.</p>
          </div>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-2xl font-semibold text-white">₹</span>
            <span class="price-val text-5xl font-extrabold text-white tracking-tight" data-monthly="7,999" data-yearly="79,999">7,999</span>
            <span class="billing-period text-slate-400 font-medium">/mo</span>
          </div>
          <hr class="border-slate-700 mb-8" />
          <ul class="flex-grow space-y-4 mb-8">
            <li class="flex gap-3 text-sm text-slate-200">
              <svg class="w-5 h-5 text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>750 AI Strategic Actions / month</strong></span>
            </li>
            <li class="flex gap-3 text-sm text-slate-200">
              <svg class="w-5 h-5 text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Rajnesh v. Neha Disclosure Generator:</strong> Auto-format complex financial affidavits to comply with Supreme Court mandatory templates.</span>
            </li>
            <li class="flex gap-3 text-sm text-slate-200">
              <svg class="w-5 h-5 text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>WhatsApp & Email Evidence Sorter:</strong> Tag, date, and organize toxic chat screenshots into structured court annexures.</span>
            </li>
            <li class="flex gap-3 text-sm text-slate-200">
              <svg class="w-5 h-5 text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Live Precedent Cross-Check:</strong> Real-time alignment against the latest High Court and Supreme Court family law judgments.</span>
            </li>
            <li class="flex gap-3 text-sm text-slate-200">
              <svg class="w-5 h-5 text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Co-Parenting Communication Shield:</strong> Neutralize heated drafts into dispute-proof, court-safe parenting responses.</span>
            </li>
          </ul>
          <a href="#checkout" class="block w-full py-3.5 px-4 rounded-xl text-center font-bold transition-all bg-gradient-to-r from-indigo-500 to-purple-500 text-white shadow-lg hover:shadow-indigo-500/25 hover:opacity-95 border border-transparent hover:-translate-y-0.5">Choose Litigation Pro</a>
        </div>

        <!-- Trial Suite -->
        <div class="bg-white border border-slate-200 rounded-3xl p-8 flex flex-col shadow-sm hover:shadow-md hover:-translate-y-1 hover:border-slate-300 transition-all duration-300">
          <div class="mb-6">
            <h3 class="text-2xl font-bold text-slate-900 mb-2">Trial Suite</h3>
            <p class="text-sm text-slate-600 min-h-[3rem]">Unrestricted workspace for intensive cross-examinations, forensic asset division, and high-conflict trials.</p>
          </div>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-2xl font-semibold text-slate-900">₹</span>
            <span class="price-val text-5xl font-extrabold text-slate-900 tracking-tight" data-monthly="21,999" data-yearly="219,999">21,999</span>
            <span class="billing-period text-slate-500 font-medium">/mo</span>
          </div>
          <hr class="border-slate-100 mb-8" />
          <ul class="flex-grow space-y-4 mb-8">
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>2,000 AI Strategic Actions / month</strong></span>
            </li>
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>AI Mock Cross-Examination:</strong> Rehearse tough, hostile questions before you step into the witness box.</span>
            </li>
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Section 63 BSA Electronic Packager:</strong> Format digital logs to strictly fulfill new Indian electronic evidence certificate criteria.</span>
            </li>
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Contradiction Analyzer:</strong> Cross-check opposing petitions across maintenance, custody, and domestic violence filings to highlight discrepancies.</span>
            </li>
            <li class="flex gap-3 text-sm text-slate-700">
              <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Multi-Property Forensic Breakdown:</strong> Analyze complex joint real estate, business valuations, and ancestral property claims.</span>
            </li>
          </ul>
          <a href="#checkout" class="block w-full py-3.5 px-4 rounded-xl text-center font-bold transition-all border-2 border-slate-200 bg-transparent text-slate-900 hover:border-slate-900 hover:bg-slate-50">Choose Trial Suite</a>
        </div>

      </div>

      <!-- Long-term Proceedings Context -->
      <div class="bg-gradient-to-br from-slate-900 to-slate-800 border border-slate-700 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 text-white shadow-xl">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold mb-3 text-white">Why an Annual Plan makes strategic sense</h2>
          <p class="text-slate-300 leading-relaxed">
            Contested matrimonial disputes in Indian family courts take 3 to 7 years on average. Securing an annual plan guarantees uninterrupted document access, preserves entire cross-examination histories, and locks in discounted rates for long-term proceedings.
          </p>
        </div>
        <div class="flex-shrink-0 bg-indigo-500/10 border border-indigo-500/30 px-8 py-5 rounded-2xl text-center backdrop-blur-sm">
          <div class="text-4xl font-extrabold text-indigo-300 tracking-tight leading-none mb-1">~20% OFF</div>
          <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-2">Applied on Yearly Plans</div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  // Wait for the DOM to load before attaching event listeners
  document.addEventListener('DOMContentLoaded', () => {
    const tabMonthly = document.getElementById('tabMonthly');
    const tabYearly = document.getElementById('tabYearly');
    const slider = document.getElementById('activeSlider');
    const priceVals = document.querySelectorAll('.price-val');
    const periodVals = document.querySelectorAll('.billing-period');

    function animateValueChange(element, newValue) {
      element.style.opacity = '0';
      element.style.transform = 'translateY(4px)';
      setTimeout(() => {
        element.innerText = newValue;
        element.style.opacity = '1';
        element.style.transform = 'translateY(0)';
      }, 150);
      element.style.transition = 'all 0.15s ease-out';
    }

    tabMonthly.addEventListener('click', () => {
      // Update Button Text Colors
      tabMonthly.classList.replace('text-slate-500', 'text-white');
      tabYearly.classList.replace('text-white', 'text-slate-500');
      
      // Move Slider
      slider.classList.remove('translate-x-full');
      
      // Update Prices
      priceVals.forEach((el, index) => {
        animateValueChange(el, el.getAttribute('data-monthly'));
        periodVals[index].innerText = '/mo';
      });
    });

    tabYearly.addEventListener('click', () => {
      // Update Button Text Colors
      tabYearly.classList.replace('text-slate-500', 'text-white');
      tabMonthly.classList.replace('text-white', 'text-slate-500');
      
      // Move Slider
      slider.classList.add('translate-x-full');
      
      // Update Prices
      priceVals.forEach((el, index) => {
        animateValueChange(el, el.getAttribute('data-yearly'));
        periodVals[index].innerText = '/yr';
      });
    });
  });
</script>