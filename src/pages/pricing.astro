---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing - AI Legal Companion">
  <div class="bg-[#FBF9F5] min-h-screen py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-20">
        <p class="text-slate-500 text-sm font-medium mb-4">Built for Indian family court systems</p>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-slate-900 mb-6 leading-[1.1]">
          Strategic clarity for your divorce proceedings
        </h1>
        <p class="text-lg text-slate-600 leading-relaxed">
          Eliminate hourly retainer anxiety. Automate statutory disclosures, structure electronic WhatsApp evidence, and prepare strategic filings with AI accuracy.
        </p>
      </div>

      <!-- Segmented Control Toggle -->
      <div class="billing-toggle-container flex justify-center mb-14 sm:mb-20">
        <div class="relative bg-white border border-slate-200 p-1.5 rounded-full inline-flex w-80">
          <div id="activeSlider" class="absolute top-1.5 left-1.5 bottom-1.5 w-[calc(50%-6px)] bg-slate-900 rounded-full transition-transform duration-300 ease-out z-0"></div>

          <button id="tabMonthly" class="relative z-10 w-1/2 py-2.5 text-sm font-semibold text-white transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 rounded-full">
            Monthly billing
          </button>
          <button id="tabYearly" class="relative z-10 w-1/2 py-2.5 text-sm font-semibold text-slate-500 transition-colors duration-200 flex items-center justify-center gap-1.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 rounded-full">
            Yearly <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded-full text-[0.7rem] font-medium">2 mo free</span>
          </button>
        </div>
      </div>

      <!-- Pricing Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-5 mb-16 sm:mb-20 lg:items-center">

        <!-- Clarity Plan -->
        <div class="bg-white border border-slate-200 rounded-2xl p-8 md:p-10 flex flex-col">
          <div class="mb-6">
            <h3 class="font-serif text-2xl text-slate-900 mb-2">Clarity</h3>
            <p class="text-sm text-slate-500 min-h-[3rem]">Designed for initial assessment, amicable mutual consent, and petition structuring.</p>
          </div>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-xl font-medium text-slate-900">₹</span>
            <span class="price-val font-serif text-4xl text-slate-900 tracking-tight" data-monthly="2,499" data-yearly="23,999">2,499</span>
            <span class="billing-period text-slate-500 text-sm">/mo</span>
          </div>
          <ul class="flex-grow divide-y divide-slate-100 mb-8">
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-600 first:pt-0">
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span class="font-semibold text-slate-900">200 AI strategic actions / month</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-600">
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-slate-900 font-semibold">Plain-language notice translator:</strong> instant Hindi & English breakdowns of opposing counsel summons and legal notices.</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-600">
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-slate-900 font-semibold">Stridhan & dowry inventory vault:</strong> structure itemized jewelry, gifts, and recovery schedules ready for court submission.</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-600">
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-slate-900 font-semibold">Marital timeline builder:</strong> convert years of complex domestic history into a clear, fact-checked chronology for your advocate.</span>
            </li>
          </ul>
          <a href="#checkout" class="block w-full py-3 px-4 rounded-lg text-center text-sm font-semibold transition-colors border border-slate-300 bg-white text-slate-900 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Choose Clarity</a>
        </div>

        <!-- Litigation Pro (Featured) -->
        <div class="bg-slate-900 border border-slate-900 rounded-2xl p-8 md:p-10 flex flex-col lg:scale-105">
          <p class="text-slate-400 text-sm font-medium mb-4">Most recommended</p>
          <div class="mb-6">
            <h3 class="font-serif text-2xl text-white mb-2">Litigation Pro</h3>
            <p class="text-sm text-slate-300 min-h-[3rem]">Comprehensive toolkit for contested petitions, custody battles, and maintenance hearings.</p>
          </div>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-xl font-medium text-white">₹</span>
            <span class="price-val font-serif text-4xl text-white tracking-tight" data-monthly="7,999" data-yearly="79,999">7,999</span>
            <span class="billing-period text-slate-400 text-sm">/mo</span>
          </div>
          <ul class="flex-grow divide-y divide-slate-700 mb-8">
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-300 first:pt-0">
              <svg class="w-4 h-4 text-slate-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span class="font-semibold text-white">750 AI strategic actions / month</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-300">
              <svg class="w-4 h-4 text-slate-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-white font-semibold">Rajnesh v. Neha disclosure generator:</strong> auto-format complex financial affidavits to comply with Supreme Court mandatory templates.</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-300">
              <svg class="w-4 h-4 text-slate-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-white font-semibold">WhatsApp & email evidence sorter:</strong> tag, date, and organize toxic chat screenshots into structured court annexures.</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-300">
              <svg class="w-4 h-4 text-slate-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-white font-semibold">Live precedent cross-check:</strong> real-time alignment against the latest High Court and Supreme Court family law judgments.</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-300">
              <svg class="w-4 h-4 text-slate-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-white font-semibold">Co-parenting communication shield:</strong> neutralize heated drafts into dispute-proof, court-safe parenting responses.</span>
            </li>
          </ul>
          <a href="#checkout" class="block w-full py-3 px-4 rounded-lg text-center text-sm font-semibold transition-colors bg-white text-slate-900 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Choose Litigation Pro</a>
        </div>

        <!-- Trial Suite -->
        <div class="bg-white border border-slate-200 rounded-2xl p-8 md:p-10 flex flex-col">
          <div class="mb-6">
            <h3 class="font-serif text-2xl text-slate-900 mb-2">Trial Suite</h3>
            <p class="text-sm text-slate-500 min-h-[3rem]">Unrestricted workspace for intensive cross-examinations, forensic asset division, and high-conflict trials.</p>
          </div>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-xl font-medium text-slate-900">₹</span>
            <span class="price-val font-serif text-4xl text-slate-900 tracking-tight" data-monthly="21,999" data-yearly="219,999">21,999</span>
            <span class="billing-period text-slate-500 text-sm">/mo</span>
          </div>
          <ul class="flex-grow divide-y divide-slate-100 mb-8">
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-600 first:pt-0">
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span class="font-semibold text-slate-900">2,000 AI strategic actions / month</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-600">
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-slate-900 font-semibold">AI mock cross-examination:</strong> rehearse tough, hostile questions before you step into the witness box.</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-600">
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-slate-900 font-semibold">Section 63 BSA electronic packager:</strong> format digital logs to strictly fulfill electronic evidence certificate criteria.</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-600">
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-slate-900 font-semibold">Contradiction analyzer:</strong> cross-check opposing petitions across maintenance, custody, and domestic violence filings to highlight discrepancies.</span>
            </li>
            <li class="flex items-start gap-3 py-3.5 text-sm text-slate-600">
              <svg class="w-4 h-4 text-slate-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong class="text-slate-900 font-semibold">Multi-property forensic breakdown:</strong> analyze complex joint real estate, business valuations, and ancestral property claims.</span>
            </li>
          </ul>
          <a href="#checkout" class="block w-full py-3 px-4 rounded-lg text-center text-sm font-semibold transition-colors border border-slate-300 bg-white text-slate-900 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Choose Trial Suite</a>
        </div>

      </div>

      <!-- Long-term Proceedings Context -->
      <div class="bg-white border border-slate-200 rounded-2xl p-8 md:p-12 flex flex-col lg:flex-row items-center justify-between gap-10">
        <div class="max-w-2xl">
          <h2 class="font-serif text-2xl md:text-3xl text-slate-900 mb-3">Why an annual plan makes strategic sense</h2>
          <p class="text-slate-600 leading-relaxed">
            Contested matrimonial disputes in Indian family courts can take several years to resolve. An annual plan provides uninterrupted document access, preserves your case history, and saves roughly 20% over paying monthly.
          </p>
        </div>
        <div class="flex-shrink-0 w-full lg:w-auto">
          <button id="applyAnnualBtn" class="w-full lg:w-auto px-6 py-3 bg-slate-900 text-white text-sm font-semibold rounded-lg hover:bg-slate-800 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 whitespace-nowrap">
            Apply annual plan
          </button>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap');

  .font-serif {
    font-family: 'Source Serif 4', ui-serif, Georgia, serif;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabMonthly = document.getElementById('tabMonthly');
    const tabYearly = document.getElementById('tabYearly');
    const slider = document.getElementById('activeSlider');
    const priceVals = document.querySelectorAll('.price-val');
    const periodVals = document.querySelectorAll('.billing-period');
    const applyAnnualBtn = document.getElementById('applyAnnualBtn');

    function animateValueChange(element, newValue) {
      element.style.opacity = '0';
      element.style.transform = 'translateY(4px)';
      setTimeout(() => {
        element.innerText = newValue;
        element.style.opacity = '1';
        element.style.transform = 'translateY(0)';
      }, 150);
      element.style.transition = 'all 0.15s ease-out';
    }

    tabMonthly.addEventListener('click', () => {
      tabMonthly.classList.replace('text-slate-500', 'text-white');
      tabYearly.classList.replace('text-white', 'text-slate-500');
      slider.classList.remove('translate-x-full');
      priceVals.forEach((el, index) => {
        animateValueChange(el, el.getAttribute('data-monthly'));
        periodVals[index].innerText = '/mo';
      });
    });

    tabYearly.addEventListener('click', () => {
      tabYearly.classList.replace('text-slate-500', 'text-white');
      tabMonthly.classList.replace('text-white', 'text-slate-500');
      slider.classList.add('translate-x-full');
      priceVals.forEach((el, index) => {
        animateValueChange(el, el.getAttribute('data-yearly'));
        periodVals[index].innerText = '/yr';
      });
    });

    if (applyAnnualBtn) {
      applyAnnualBtn.addEventListener('click', () => {
        tabYearly.click();
        const toggleContainer = document.querySelector('.billing-toggle-container');
        if (toggleContainer) {
          window.scrollTo({
            top: toggleContainer.getBoundingClientRect().top + window.scrollY - 100,
            behavior: 'smooth'
          });
        }
      });
    }
  });
</script>