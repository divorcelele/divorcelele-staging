---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing - AI Legal Companion">
  <div class="bg-stone-50 min-h-screen py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-gray-200 text-slate-600 text-xs font-semibold tracking-wide uppercase mb-6 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-900"></span>
          Built for Indian Family Court Systems
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight text-slate-900 mb-6 leading-tight">
          Strategic clarity for your <br class="hidden md:block" /> divorce proceedings.
        </h1>
        <p class="text-lg md:text-xl text-slate-600 mb-10 max-w-2xl mx-auto font-light leading-relaxed">
          Eliminate hourly retainer anxiety. Automate statutory disclosures, structure electronic WhatsApp evidence, and prepare strategic filings with AI accuracy.
        </p>
      </div>

      <!-- Segmented Control Toggle -->
      <div class="billing-toggle-container flex justify-center mb-16">
        <div class="relative bg-white border border-gray-200 p-1.5 rounded-full inline-flex shadow-sm w-80">
          <!-- Sliding Background -->
          <div id="activeSlider" class="absolute top-1.5 left-1.5 bottom-1.5 w-[calc(50%-6px)] bg-slate-900 rounded-full transition-transform duration-300 ease-out z-0"></div>
          
          <button id="tabMonthly" class="relative z-10 w-1/2 py-2.5 text-sm font-semibold text-white transition-colors duration-200 focus:outline-none">
            Monthly Billing
          </button>
          <button id="tabYearly" class="relative z-10 w-1/2 py-2.5 text-sm font-semibold text-slate-500 transition-colors duration-200 flex items-center justify-center gap-1.5 focus:outline-none">
            Yearly <span class="bg-gray-100 text-slate-900 border border-gray-200 px-2 py-0.5 rounded-full text-[0.65rem] font-bold uppercase tracking-wider">2 Mo Free</span>
          </button>
        </div>
      </div>

      <!-- Pricing Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-20 items-center">
        
        <!-- Clarity Plan -->
        <div class="bg-white border border-gray-200 rounded-[2rem] p-8 md:p-10 flex flex-col shadow-sm hover:shadow-md transition-all duration-300">
          <div class="mb-6">
            <h3 class="text-2xl font-semibold text-slate-900 mb-2">Clarity</h3>
            <p class="text-sm text-slate-500 min-h-[3rem]">Designed for initial assessment, amicable mutual consent, and petition structuring.</p>
          </div>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-2xl font-medium text-slate-900">₹</span>
            <span class="price-val text-5xl font-medium text-slate-900 tracking-tight" data-monthly="2,499" data-yearly="23,999">2,499</span>
            <span class="billing-period text-slate-500 font-medium">/mo</span>
          </div>
          <hr class="border-gray-100 mb-8" />
          <ul class="flex-grow space-y-4 mb-8">
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>200 AI Strategic Actions / month</strong></span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Plain-Language Notice Translator:</strong> Instant Hindi & English breakdowns of opposing counsel summons and legal notices.</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Stridhan & Dowry Inventory Vault:</strong> Structure itemized jewelry, gifts, and recovery schedules ready for court submission.</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Marital Timeline Builder:</strong> Convert years of complex domestic history into a clear, fact-checked chronology for your advocate.</span>
            </li>
          </ul>
          <a href="#checkout" class="block w-full py-4 px-4 rounded-full text-center font-medium transition-colors border border-gray-300 bg-white text-slate-900 hover:bg-gray-50">Choose Clarity</a>
        </div>

        <!-- Litigation Pro (Featured) -->
        <div class="relative bg-slate-900 border border-slate-900 rounded-[2rem] p-8 md:p-10 flex flex-col shadow-xl lg:scale-105 z-10">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-white text-slate-900 px-4 py-1.5 rounded-full text-[0.7rem] font-bold uppercase tracking-wider shadow-sm border border-gray-200">
            Most Recommended
          </div>
          <div class="mb-6 mt-2">
            <h3 class="text-2xl font-semibold text-white mb-2">Litigation Pro</h3>
            <p class="text-sm text-slate-300 min-h-[3rem]">Comprehensive toolkit for contested petitions, custody battles, and maintenance hearings.</p>
          </div>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-2xl font-medium text-white">₹</span>
            <span class="price-val text-5xl font-medium text-white tracking-tight" data-monthly="7,999" data-yearly="79,999">7,999</span>
            <span class="billing-period text-slate-400 font-medium">/mo</span>
          </div>
          <hr class="border-slate-700 mb-8" />
          <ul class="flex-grow space-y-4 mb-8">
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>750 AI Strategic Actions / month</strong></span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Rajnesh v. Neha Disclosure Generator:</strong> Auto-format complex financial affidavits to comply with Supreme Court mandatory templates.</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>WhatsApp & Email Evidence Sorter:</strong> Tag, date, and organize toxic chat screenshots into structured court annexures.</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Live Precedent Cross-Check:</strong> Real-time alignment against the latest High Court and Supreme Court family law judgments.</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Co-Parenting Communication Shield:</strong> Neutralize heated drafts into dispute-proof, court-safe parenting responses.</span>
            </li>
          </ul>
          <a href="#checkout" class="block w-full py-4 px-4 rounded-full text-center font-medium transition-colors bg-white text-slate-900 hover:bg-gray-100">Choose Litigation Pro</a>
        </div>

        <!-- Trial Suite -->
        <div class="bg-white border border-gray-200 rounded-[2rem] p-8 md:p-10 flex flex-col shadow-sm hover:shadow-md transition-all duration-300">
          <div class="mb-6">
            <h3 class="text-2xl font-semibold text-slate-900 mb-2">Trial Suite</h3>
            <p class="text-sm text-slate-500 min-h-[3rem]">Unrestricted workspace for intensive cross-examinations, forensic asset division, and high-conflict trials.</p>
          </div>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-2xl font-medium text-slate-900">₹</span>
            <span class="price-val text-5xl font-medium text-slate-900 tracking-tight" data-monthly="21,999" data-yearly="219,999">21,999</span>
            <span class="billing-period text-slate-500 font-medium">/mo</span>
          </div>
          <hr class="border-gray-100 mb-8" />
          <ul class="flex-grow space-y-4 mb-8">
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>2,000 AI Strategic Actions / month</strong></span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>AI Mock Cross-Examination:</strong> Rehearse tough, hostile questions before you step into the witness box.</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Section 63 BSA Electronic Packager:</strong> Format digital logs to strictly fulfill new Indian electronic evidence certificate criteria.</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Contradiction Analyzer:</strong> Cross-check opposing petitions across maintenance, custody, and domestic violence filings to highlight discrepancies.</span>
            </li>
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Multi-Property Forensic Breakdown:</strong> Analyze complex joint real estate, business valuations, and ancestral property claims.</span>
            </li>
          </ul>
          <a href="#checkout" class="block w-full py-4 px-4 rounded-full text-center font-medium transition-colors border border-gray-300 bg-white text-slate-900 hover:bg-gray-50">Choose Trial Suite</a>
        </div>

      </div>

      <!-- Long-term Proceedings Context -->
      <div class="bg-[#f5f5f7] border border-gray-200 rounded-[2rem] p-8 md:p-12 flex flex-col lg:flex-row items-center justify-between gap-10 text-slate-900">
        <div class="max-w-3xl flex-grow">
          <div class="flex items-center gap-3 mb-4">
            <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">Why an Annual Plan makes strategic sense</h2>
            <span class="hidden md:inline-block bg-slate-900 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">~20% OFF</span>
          </div>
          <p class="text-lg text-slate-600 font-medium leading-relaxed">
            Contested matrimonial disputes in Indian family courts take 3 to 7 years on average. Securing an annual plan guarantees uninterrupted document access, preserves entire cross-examination histories, and locks in discounted rates for long-term proceedings.
          </p>
        </div>
        <div class="flex-shrink-0 w-full lg:w-auto">
          <button id="applyAnnualBtn" class="w-full lg:w-auto px-8 py-4 bg-slate-900 text-white text-lg font-medium rounded-full hover:bg-black transition-colors shadow-md whitespace-nowrap">
            Apply Annual Plan
          </button>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabMonthly = document.getElementById('tabMonthly');
    const tabYearly = document.getElementById('tabYearly');
    const slider = document.getElementById('activeSlider');
    const priceVals = document.querySelectorAll('.price-val');
    const periodVals = document.querySelectorAll('.billing-period');
    const applyAnnualBtn = document.getElementById('applyAnnualBtn');

    function animateValueChange(element, newValue) {
      element.style.opacity = '0';
      element.style.transform = 'translateY(4px)';
      setTimeout(() => {
        element.innerText = newValue;
        element.style.opacity = '1';
        element.style.transform = 'translateY(0)';
      }, 150);
      element.style.transition = 'all 0.15s ease-out';
    }

    tabMonthly.addEventListener('click', () => {
      // Update Button Text Colors
      tabMonthly.classList.replace('text-slate-500', 'text-white');
      tabYearly.classList.replace('text-white', 'text-slate-500');
      
      // Move Slider
      slider.classList.remove('translate-x-full');
      
      // Update Prices
      priceVals.forEach((el, index) => {
        animateValueChange(el, el.getAttribute('data-monthly'));
        periodVals[index].innerText = '/mo';
      });
    });

    tabYearly.addEventListener('click', () => {
      // Update Button Text Colors
      tabYearly.classList.replace('text-slate-500', 'text-white');
      tabMonthly.classList.replace('text-white', 'text-slate-500');
      
      // Move Slider
      slider.classList.add('translate-x-full');
      
      // Update Prices
      priceVals.forEach((el, index) => {
        animateValueChange(el, el.getAttribute('data-yearly'));
        periodVals[index].innerText = '/yr';
      });
    });

    // Wire up the new bottom button
    if(applyAnnualBtn) {
      applyAnnualBtn.addEventListener('click', () => {
        tabYearly.click();
        // Smooth scroll back up to the toggle
        const toggleContainer = document.querySelector('.billing-toggle-container');
        if (toggleContainer) {
          window.scrollTo({
            top: toggleContainer.getBoundingClientRect().top + window.scrollY - 100,
            behavior: 'smooth'
          });
        }
      });
    }
  });
</script>