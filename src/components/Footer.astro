---
const currentYear = new Date().getFullYear();
---
<footer class="bg-white border-t border-slate-200 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    
    <!-- Changed to flex layout to separate brand column from link columns -->
    <div class="flex flex-col lg:flex-row justify-between gap-12 lg:gap-8 mb-12 lg:mb-16">
      
      <!-- Brand Column -->
      <div class="lg:w-1/3 text-left">
        <a href="/" class="block mb-6">
          <img src="/divorcelele.svg" alt="DivorceLele Logo" class="h-8 w-auto" />
        </a>
        <p class="text-sm text-slate-500 leading-relaxed max-w-xs">
          Your strategic advantage in Indian Family Court. Prepare filings, organize evidence, and secure your future with AI.
        </p>
        <div class="mt-6 flex space-x-4">
          <a href="#" class="text-slate-400 hover:text-slate-900 transition-colors">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="#" class="text-slate-400 hover:text-slate-900 transition-colors">
            <span class="sr-only">Twitter</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.008 5.918H5.078z"/></svg>
          </a>
        </div>
      </div>

      <!-- Navigation Columns: 2 cols on mobile, 3 cols on desktop -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-10 lg:w-2/3">
        <div>
          <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4">Product</h3>
          <ul class="space-y-3">
            <li><a href="/divorce-assistant" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">AI Assistant</a></li>
            <li><a href="/pricing" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Pricing & Plans</a></li>
            <li><a href="/guides" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Free Legal Guides</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4">Support</h3>
          <ul class="space-y-3">
            <li><a href="/faq" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">FAQs</a></li>
            <li><a href="/contact" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Contact Us</a></li>
            <li><a href="/about" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">About the Team</a></li>
          </ul>
        </div>

        <!-- The col-span-2 class on mobile makes this specific section span across the bottom neatly -->
        <div class="col-span-2 md:col-span-1">
          <h3 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4">Legal</h3>
          <ul class="space-y-3">
            <li><a href="/privacy" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Terms of Service</a></li>
            <li><a href="/data-request" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">Data Deletion</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="border-t border-slate-200 pt-8">
      <p class="text-xs text-slate-400 mb-4 leading-relaxed text-justify md:text-left">
        <strong>Disclaimer:</strong> DivorceLele is a technology platform providing AI-driven assistance and legal information. We are not a law firm, and the use of our services does not create an attorney-client relationship. Our tools are designed to prepare you for legal proceedings and assist your retained advocate. Always consult with a licensed legal professional in your jurisdiction before making binding legal decisions.
      </p>
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
        <p class="text-sm text-slate-500">
          &copy; {currentYear} DivorceLele. All rights reserved.
        </p>
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-green-500"></span>
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">All Systems Operational</span>
        </div>
      </div>
    </div>

  </div>
</footer>